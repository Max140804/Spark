# PostgreSQL database URL. Prefer your host's pooled URL for web traffic.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Generate a unique secret (at least 32 bytes) for this environment.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-unique-random-secret-of-at-least-32-bytes"

# SMTP is required for account verification and password resets.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="SPARK <no-reply@example.com>"

# Live lessons require a configured LiveKit project.
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# Required before enabling user uploads.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Seed script only; never use production credentials here.
SEED_PASSWORD="replace-with-a-unique-password-of-at-least-12-characters"
